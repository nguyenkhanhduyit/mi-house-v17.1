{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run dev",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/seed-content.json,src/cms/initialContent.json}"
    }
  },
  "redirects": [
    {"source":"/lien-he","destination":"/","permanent":true}
  ],
  "rewrites": [
    {"source":"/api/:path*", "destination":"/api/index?__cms_path=:path*"},
    {"source":"/(.*)","destination":"/index.html"}
  ]
}
